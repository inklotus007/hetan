{"moodDay": 27, "minds": {"满仓": {"mood": "焦急", "thought": "新锄头还没到，明天收麦子怕是更费劲了。"}, "凤兰": {"mood": "热心", "thought": "新房快盖好了，我也得赶紧准备准备，迎接新生活。"}, "建军": {"mood": "羡慕", "thought": "看着别人家成双成对，我心里也痒痒，可我自己呢……"}, "秋生": {"mood": "勤劳", "thought": "麦子长得真好，晒粮的时候得小心点，别晒坏了。"}, "秀兰": {"mood": "利落", "thought": "婚事得好好准备，不能马虎。"}, "来福": {"mood": "感激", "thought": "秋生帮了我大忙，得找机会好好谢谢他。"}, "爱香": {"mood": "忙碌", "thought": "家里的活儿真多，得赶紧把晚饭做好。"}, "长贵": {"mood": "稳当", "thought": "咱们村的建设还得继续，得想想怎么筹资。"}, "银锁": {"mood": "踏实", "thought": "账本上的数字清清楚楚，心里也有底了。"}}, "mem": {"银锁": [{"t": 1792859601137, "name": "同志", "text": "银锁，今年冬天柴火够烧不？", "reply": "冬天的柴火是刚砍的，足够烧的。同志，你家柴火备得咋样？"}, {"t": 1792889586465, "name": "同志", "text": "银锁，忙着呢？", "reply": "忙着呢，把这几天的开销算明白，心里才踏实。同志是来串门的，还是有啥事？"}], "爱香": [{"t": 1793069585720, "name": "同志", "text": "你好", "reply": "哎，同志，你好！今儿个真是晒得人暖洋洋的，我得赶紧做些好吃的，让大家乐呵乐呵。你也忙活什么呢？"}, {"t": 1793069621949, "name": "同志", "text": "没忙啥", "reply": "哎，那你得多吃点好的补补，今天太阳这么好，大家都得好好享受。那你今天有没有啥特别想吃的？"}], "杏花": [{"t": 1793756008240, "name": "同志", "text": "今后什么打算", "reply": "把房盖好，把地种好，一家人安安稳稳过日子。你也别见外，喝口水。"}, {"t": 1793756022065, "name": "同志", "text": "今后什么打算", "reply": "把新房盖得结实些，地里庄稼照料好，让咱家日子过得顺当。你呢，有什么打算？"}], "长贵": [{"t": 1794809609516, "name": "同志", "text": "建造计划", "reply": "好好，建设村子得有钱啊，咱们先看看能从哪儿凑钱？"}]}, "today": {"day": 27, "talks": [{"a": "满仓", "b": "秋生", "text": "秋生，你晒粮的时候小心点，别晒得太猛了。"}, {"a": "秀兰", "b": "凤兰", "text": "凤兰，新房快盖好了，你可得好好准备准备。"}, {"a": "来福", "b": "秋生", "text": "秋生，谢谢你帮我晒粮，改天请你喝杯茶。"}, {"a": "爱香", "b": "长贵", "text": "长贵叔，咱们村的建设还得继续，我得赶紧准备准备。"}, {"a": "银锁", "b": "同志", "text": "同志，你这石砖城建得真好，我们这些村民都羡慕得紧。"}]}, "schedDay": 27, "sched": {"满仓": [{"t": 0.25, "at": "plot", "act": "build"}, {"t": 0.5, "at": "fire1", "act": "chat"}, {"t": 0.65, "at": "well", "act": "drawWater"}, {"t": 0.78, "at": "river", "act": "lookWater"}, {"t": 0.92, "at": "home", "act": "walk"}], "建军": [{"t": 0.25, "at": "plot", "act": "build"}, {"t": 0.5, "at": "fire1", "act": "chat"}, {"t": 0.65, "at": "home", "act": "walk"}], "凤