{"moodDay": 5, "minds": {"满仓": {"mood": "期待", "thought": "还有两天屋顶就能完工，一定要保证质量，不能让新婚的凤兰担心。"}, "凤兰": {"mood": "担忧", "thought": "满仓太急了，屋顶工程要小心，别让雨季来了出岔子。"}, "建军": {"mood": "羡慕", "thought": "看着别人成双成对，自己还是单身，心里有点不是滋味。"}, "秋生": {"mood": "小心", "thought": "手上的伤口不能大意，得小心干活，别让秀兰担心。"}, "秀兰": {"mood": "关心", "thought": "秋生的手伤一定要照顾好，今天得想个办法让他不那么辛苦。"}, "来福": {"mood": "勤劳", "thought": "天还没亮就起来，今天得赶在太阳出来之前把地里的活干完。"}, "爱香": {"mood": "热情", "thought": "今天天气这么好，得多做点好吃的，让大家高兴高兴。"}, "长贵": {"mood": "稳重", "thought": "账务一定要仔细，银锁你今天得再检查一遍。"}, "银锁": {"mood": "认真", "thought": "今天的账务要仔细核算，不能有半点马虎。"}}, "mem": {"银锁": [{"t": 1792859601137, "name": "同志", "text": "银锁，今年冬天柴火够烧不？", "reply": "冬天的柴火是刚砍的，足够烧的。同志，你家柴火备得咋样？"}, {"t": 1792889586465, "name": "同志", "text": "银锁，忙着呢？", "reply": "忙着呢，把这几天的开销算明白，心里才踏实。同志是来串门的，还是有啥事？"}], "爱香": [{"t": 1793069585720, "name": "同志", "text": "你好", "reply": "哎，同志，你好！今儿个真是晒得人暖洋洋的，我得赶紧做些好吃的，让大家乐呵乐呵。你也忙活什么呢？"}, {"t": 1793069621949, "name": "同志", "text": "没忙啥", "reply": "哎，那你得多吃点好的补补，今天太阳这么好，大家都得好好享受。那你今天有没有啥特别想吃的？"}]}, "today": {"day": 5, "talks": [{"a": "满仓", "b": "凤兰", "text": "凤兰，你放心，屋顶我会小心做的，不会让你担心。"}, {"a": "秋生", "b": "秀兰", "text": "秀兰，我的手伤没事，你不用那么担心。"}, {"a": "银锁", "b": "长贵", "text": "长贵，我已经仔细检查过了，账务没问题。"}, {"a": "爱香", "b": "来福", "text": "来福，你辛苦了，今天晚上我给你做顿好吃的。"}]}, "schedDay": 5, "sched": {"满仓": [{"t": 0.25, "at": "plot", "act": "build"}, {"t": 0.5, "at": "fire1", "act": "chat"}, {"t": 0.65, "at": "well", "act": "drawWater"}, {"t": 0.78, "at": "river", "act": "lookWater"}, {"t": 0.92, "at": "home", "act": "walk"}], "凤兰": [{"t": 0.25, "at": "plot", "act": "supervise"}, {"t": 0.5, "at": "fire1", "act": "chat"}, {"t": 0.65, "at": "well", "act": "drawWater"}, {"t": 0.78, "at": "river", "act": "watchWork"}, {"t": 0.92, "at": "home", "act": "walk"}], "建军": [{"t": 0.25, "at": "fire1", "act": "observe"}, {"t": 0.5, "at": "fire2", "act": "chat"}, {"t": 0.65, "at": "plot", "act": "observe"}, {"t": 0.78, "at": "river", "act": "meditate"}, {"t": 0.92, "at": "home", "act": "walk"}],