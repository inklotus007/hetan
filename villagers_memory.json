{"moodDay": 8, "minds": {"满仓": {"mood": "期盼", "thought": "今天又过去了一天，凤兰的婚期越来越近，希望一切顺利。"}, "凤兰": {"mood": "忙碌", "thought": "新房的屋顶工程要抓紧，秀兰帮忙很用心，我也得加把劲。"}, "建军": {"mood": "感慨", "thought": "看着别人成双成对，心里有些孤单，但也希望早日找到自己的幸福。"}, "秋生": {"mood": "踏实", "thought": "屋顶工程进展顺利，秀兰帮忙，心里暖暖的，希望生活就这样平淡下去。"}, "秀兰": {"mood": "满足", "thought": "能帮秋生分担一些工作，心里很高兴，我们的小家越来越好。"}, "来福": {"mood": "兴奋", "thought": "新房的屋顶越来越像样了，爱香一定会喜欢。"}, "爱香": {"mood": "快乐", "thought": "今天天气真好，大家都很高兴，我也要多做些好吃的，让大家开心。"}, "长贵": {"mood": "认真", "thought": "账务要细心，不能出一点差错，这是对大家负责。"}, "银锁": {"mood": "细心", "thought": "把这几天的开销算明白，心里才踏实，生活就是这样，一分一厘都要计较。"}}, "mem": {"银锁": [{"t": 1792859601137, "name": "同志", "text": "银锁，今年冬天柴火够烧不？", "reply": "冬天的柴火是刚砍的，足够烧的。同志，你家柴火备得咋样？"}, {"t": 1792889586465, "name": "同志", "text": "银锁，忙着呢？", "reply": "忙着呢，把这几天的开销算明白，心里才踏实。同志是来串门的，还是有啥事？"}], "爱香": [{"t": 1793069585720, "name": "同志", "text": "你好", "reply": "哎，同志，你好！今儿个真是晒得人暖洋洋的，我得赶紧做些好吃的，让大家乐呵乐呵。你也忙活什么呢？"}, {"t": 1793069621949, "name": "同志", "text": "没忙啥", "reply": "哎，那你得多吃点好的补补，今天太阳这么好，大家都得好好享受。那你今天有没有啥特别想吃的？"}]}, "today": {"day": 8, "talks": [{"a": "满仓", "b": "秋生", "text": "秋生，屋顶工程要抓紧，别耽误了凤兰的婚期。"}, {"a": "秀兰", "b": "秋生", "text": "秋生，我来帮你一起搬瓦吧，我们早点完工。"}, {"a": "爱香", "b": "长贵", "text": "长贵，今天的阳光真好，大家都在忙，我们也得好好享受一下。"}, {"a": "银锁", "b": "同志", "text": "同志，您今天又来帮忙了，真是太感谢了。"}]}, "schedDay": 8, "sched": {"满仓": [{"t": 0.25, "at": "plot", "act": "build"}, {"t": 0.5, "at": "fire1", "act": "chat"}, {"t": 0.65, "at": "well", "act": "drawWater"}, {"t": 0.78, "at": "river", "act": "lookWater"}, {"t": 0.92, "at": "home", "act": "walk"}], "凤兰": [{"t": 0.25, "at": "plot", "act": "build"}, {"t": 0.5, "at": "fire1", "act": "chat"}, {"t": 0.65, "at": "well", "act": "drawWater"}, {"t": 0.78, "at": "river", "act": "lookWater"}, {"t": 0.92, "at": "home", "act": "walk"}], "建军": [{"t": 0.25, "at": "plot", "act": "build"}, {"t": 0.5, "at": "fire1", "act": "chat"}, {"t": 0.65, "at": "well", "act": "drawWater"}, {"t": 0.78, "at": "river", "act": "lookWater"}, {"t": 0.92, 