{"moodDay": 9, "minds": {"满仓": {"mood": "期待", "thought": "再有两层瓦就齐了，心想着新房能早些住进去。"}, "凤兰": {"mood": "忙碌", "thought": "秀兰的手快，搬瓦的时候我得多帮忙，心里暖洋洋的。"}, "建军": {"mood": "落寞", "thought": "看着别人成双成对，心里有点不是滋味，自己却还是单身。"}, "秋生": {"mood": "悠闲", "thought": "今天天气好，梆子都吹得悠扬，心情格外舒畅。"}, "秀兰": {"mood": "高兴", "thought": "新房的瓦越来越厚了，心里乐开了花。"}, "来福": {"mood": "勤劳", "thought": "天还没亮就起床了，心里想着把活干得更好。"}, "爱香": {"mood": "热情", "thought": "今天阳光明媚，得给大家准备些好吃的，让大家开心。"}, "长贵": {"mood": "稳重", "thought": "账务要仔细，不能让银锁发现我的一点马虎。"}, "银锁": {"mood": "认真", "thought": "今天的账要好好核对，不能出错，这样才能让心里踏实。"}}, "mem": {"银锁": [{"t": 1792859601137, "name": "同志", "text": "银锁，今年冬天柴火够烧不？", "reply": "冬天的柴火是刚砍的，足够烧的。同志，你家柴火备得咋样？"}, {"t": 1792889586465, "name": "同志", "text": "银锁，忙着呢？", "reply": "忙着呢，把这几天的开销算明白，心里才踏实。同志是来串门的，还是有啥事？"}], "爱香": [{"t": 1793069585720, "name": "同志", "text": "你好", "reply": "哎，同志，你好！今儿个真是晒得人暖洋洋的，我得赶紧做些好吃的，让大家乐呵乐呵。你也忙活什么呢？"}, {"t": 1793069621949, "name": "同志", "text": "没忙啥", "reply": "哎，那你得多吃点好的补补，今天太阳这么好，大家都得好好享受。那你今天有没有啥特别想吃的？"}]}, "today": {"day": 9, "talks": [{"a": "满仓", "b": "秋生", "text": "秋生，今天这瓦真是越铺越高了，你看着心里是不是也跟着高兴？"}, {"a": "秀兰", "b": "爱香", "text": "爱香，今天天气真好，咱们得多干点活，争取早日完工。"}, {"a": "长贵", "b": "银锁", "text": "银锁，你看看账本，别马虎，每一笔都得清清楚楚。"}, {"a": "同志", "b": "爱香", "text": "爱香，你这做的饭真香，今天太阳这么好，大家都得多吃点好的补补。"}]}, "schedDay": 9, "sched": {"满仓": [{"t": 0.25, "at": "plot", "act": "build"}, {"t": 0.5, "at": "fire1", "act": "chat"}, {"t": 0.65, "at": "well", "act": "drawWater"}, {"t": 0.78, "at": "river", "act": "lookWater"}, {"t": 0.92, "at": "home", "act": "walk"}], "凤兰": [{"t": 0.25, "at": "plot", "act": "help"}, {"t": 0.5, "at": "fire1", "act": "chat"}, {"t": 0.65, "at": "well", "act": "drawWater"}, {"t": 0.78, "at": "river", "act": "lookWater"}, {"t": 0.92, "at": "home", "act": "walk"}], "建军": [{"t": 0.25, "at": "plot", "act": "build"}, {"t": 0.5, "at": "fire1", "act": "chat"}, {"t": 0.65, "at": "plot", "act": "build"}, {"t": 0.78, "at": "home", "act": "walk"}], "秋生": [{"t": 0.25, "at": "plot", "act": "build"}, 