{"moodDay": 10, "minds": {"满仓": {"mood": "期待", "thought": "新屋就要封顶了，日子过得真快，再过不久就可以享受新房的宁静了。"}, "凤兰": {"mood": "忙碌", "thought": "今天要忙活搬瓦，新房的每一片瓦都得小心铺设，不能出一点差错。"}, "建军": {"mood": "落寞", "thought": "看着别人成双成对，自己却还是单身，不知道未来的妻子会在哪里出现。"}, "秋生": {"mood": "专注", "thought": "手工活虽然累，但心里踏实，看着一砖一瓦搭建起来，心里特别满足。"}, "秀兰": {"mood": "细心", "thought": "瓦片堆放要整齐，这样搬起来才不费劲，还得留心着别弄脏了衣服。"}, "来福": {"mood": "热情", "thought": "爱香忙得不可开交，我得帮忙，晒得暖洋洋的，心情也好了。"}, "爱香": {"mood": "热情", "thought": "今天阳光明媚，得给大家准备些好吃的，让大家开心。"}, "长贵": {"mood": "稳重", "thought": "账本上的数字要仔细核对，不能出差错，家里的日子要细水长流。"}, "银锁": {"mood": "感激", "thought": "村里的乡亲们帮了我很多忙，今天一定要谢谢他们。"}}, "mem": {"银锁": [{"t": 1792859601137, "name": "同志", "text": "银锁，今年冬天柴火够烧不？", "reply": "冬天的柴火是刚砍的，足够烧的。同志，你家柴火备得咋样？"}, {"t": 1792889586465, "name": "同志", "text": "银锁，忙着呢？", "reply": "忙着呢，把这几天的开销算明白，心里才踏实。同志是来串门的，还是有啥事？"}], "爱香": [{"t": 1793069585720, "name": "同志", "text": "你好", "reply": "哎，同志，你好！今儿个真是晒得人暖洋洋的，我得赶紧做些好吃的，让大家乐呵乐呵。你也忙活什么呢？"}, {"t": 1793069621949, "name": "同志", "text": "没忙啥", "reply": "哎，那你得多吃点好的补补，今天太阳这么好，大家都得好好享受。那你今天有没有啥特别想吃的？"}], "杏花": [{"t": 1793756008240, "name": "同志", "text": "今后什么打算", "reply": "把房盖好，把地种好，一家人安安稳稳过日子。你也别见外，喝口水。"}, {"t": 1793756022065, "name": "同志", "text": "今后什么打算", "reply": "把新房盖得结实些，地里庄稼照料好，让咱家日子过得顺当。你呢，有什么打算？"}], "长贵": [{"t": 1794809609516, "name": "同志", "text": "建造计划", "reply": "好好，建设村子得有钱啊，咱们先看看能从哪儿凑钱？"}]}, "today": {"day": 10, "talks": [{"a": "秀兰", "b": "凤兰", "text": "凤兰姐，搬瓦可得小心点，别伤了手。"}, {"a": "银锁", "b": "来福", "text": "来福哥，今天太阳真好，谢谢你帮忙。"}, {"a": "同志", "b": "银锁", "text": "银锁，你这账本记得真清楚。"}, {"a": "同志", "b": "爱香", "text": "爱香，今天忙吗？"}]}, "schedDay": 10, "sched": {"满仓": [{"t": 0.25, "at": "plot", "act": "build"}, {"t": 0.5, "at": "fire1", "act": "chat"}, {"t": 0.65, "at": "well", "act": "drawWater"}, {"t": 0.78, "at": "river", "act": "lookWater"}, {"t": 0.92, "at": "home", "act": "walk"}], "凤兰": [{"t": 0.25, "at": "plot", "act": "build"}, {"t": 0.5, "at": "fire1", "act": "chat"}, {"t": 0.65, "at": "well", "act": "drawWater"}, {"t