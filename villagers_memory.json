{"moodDay": 4, "minds": {"满仓": {"mood": "期待", "thought": "屋顶的瓦越来越新，心里也越来越踏实，希望凤兰能早日住进新家。"}, "凤兰": {"mood": "忙碌", "thought": "新房的瓦工快完成了，心里也跟着紧张，雨季快来，希望一切都能顺利。"}, "建军": {"mood": "落寞", "thought": "看着大家成双成对，心里空落落的，是不是也该考虑自己的婚事了。"}, "秋生": {"mood": "专注", "thought": "屋顶的活儿要抓紧，秀兰在下面看着，心里只想让她早点住进温暖的家。"}, "秀兰": {"mood": "细心", "thought": "新房的进度要跟上，得提醒秋生不要累着自己，我们的新房是我们的小天地。"}, "来福": {"mood": "勤劳", "thought": "天一亮就起来，今天要给家里喂鸡喂猪，还得去地里看看庄稼。"}, "爱香": {"mood": "热情", "thought": "今天得做点好吃的，给大家补充营养，也希望孩子们能快快长大。"}, "长贵": {"mood": "稳重", "thought": "账本上的数字不能出错，要确保家里的收支平衡，大家的生活才能安心。"}, "银锁": {"mood": "谨慎", "thought": "今天要算清楚每家的账，冬天要来了，柴火要充足，不能让大家受冻。"}}, "mem": {"银锁": [{"t": 1792859601137, "name": "同志", "text": "银锁，今年冬天柴火够烧不？", "reply": "冬天的柴火是刚砍的，足够烧的。同志，你家柴火备得咋样？"}, {"t": 1792889586465, "name": "同志", "text": "银锁，忙着呢？", "reply": "忙着呢，把这几天的开销算明白，心里才踏实。同志是来串门的，还是有啥事？"}], "爱香": [{"t": 1793069585720, "name": "同志", "text": "你好", "reply": "哎，同志，你好！今儿个真是晒得人暖洋洋的，我得赶紧做些好吃的，让大家乐呵乐呵。你也忙活什么呢？"}, {"t": 1793069621949, "name": "同志", "text": "没忙啥", "reply": "哎，那你得多吃点好的补补，今天太阳这么好，大家都得好好享受。那你今天有没有啥特别想吃的？"}]}, "today": {"day": 4, "talks": [{"a": "满仓", "b": "秋生", "text": "秋生，今天太阳好，屋顶的活儿要抓紧。"}, {"a": "凤兰", "b": "满仓", "text": "满仓，屋顶加层要小心，别让雨季来时出问题。"}, {"a": "秀兰", "b": "秋生", "text": "秋生，你看你的手，小心弄伤了。"}, {"a": "长贵", "b": "银锁", "text": "银锁，账务上的事情要细心，别马虎了。"}, {"a": "爱香", "b": "孩子们", "text": "孩子们，唱首歌吧，让大家高兴高兴。"}, {"a": "来福", "b": "银锁", "text": "银锁，家里的柴火要备足，冬天不能让人受冷。"}, {"a": "建军", "b": "满仓", "text": "满仓，你的新婚生活怎么样？"}, {"a": "银锁", "b": "来福", "text": "来福，你的庄稼长得怎么样了？"}]}, "schedDay": 4, "sched": {"满仓": [{"t": 0.25, "at": "plot", "act": "build"}, {"t": 0.5, "at": "fire1", "act": "chat"}, {"t": 0.75, "at": "river", "act": "lookWater"}, {"t": 0.92, "at": "home", "act": "walk"}], "凤兰": [{"t": 0.25, "at": "plot", "act": "manage"}, {"t": 0.5, "at": "fire1", "act": "prepareDin"}, {"t": 0.75, "at": "home", "act": "cleanUp"}], "建军": [{"t": 0.3, "at": "home", "act": "sitAlone"}, {"t": 0.6, "at": "plot", "act": "watchOther"}, {"t": 